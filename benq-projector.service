[Unit]
Description=BenQ projector control via LAN with MQTT interface
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=benq
Group=benq
ExecStart=/usr/bin/python3 /opt/benq-projector/benq_projector.py -c /etc/benq-projector/benq_projector.ini run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
